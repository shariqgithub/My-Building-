rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /buildings/{buildingId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Default test connection collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
